/*
 * Guarded Evolution V5 (local, proposal-only).
 * This module cannot authorize or execute actions and has no persistence layer.
 */
(function(root) {
    const governorState = new WeakMap();
    const machineState = new WeakMap();
    const MAX_ID_LENGTH = 120;
    const RESOURCE_KEYS = ['cpuTime', 'memoryMb', 'toolCalls', 'concurrentObjectives'];

    function freezeCopy(value) {
        if (value === null || typeof value !== 'object') return value;
        if (Array.isArray(value)) return Object.freeze(value.map(freezeCopy));
        const copy = {};
        for (const key of Object.keys(value)) copy[key] = freezeCopy(value[key]);
        return Object.freeze(copy);
    }

    function validId(value) {
        return typeof value === 'string' && value.trim().length > 0 && value.length <= MAX_ID_LENGTH;
    }

    function defaultClock() {
        if (typeof performance !== 'undefined' && typeof performance.now === 'function') return performance.now();
        return Date.now();
    }

    class GlobalResourceGovernor {
        constructor(options = {}) {
            const limits = Object.assign({
                cpuTime: 10000,
                memoryMb: 512,
                toolCalls: 50,
                concurrentObjectives: 5
            }, options.limits || {});
            for (const key of RESOURCE_KEYS) {
                if (!Number.isSafeInteger(limits[key]) || limits[key] < 0) throw new TypeError(`Invalid resource limit: ${key}`);
            }
            governorState.set(this, {
                limits,
                reservations: new Map(),
                clock: typeof options.clock === 'function' ? options.clock : defaultClock
            });
        }

        _releaseExpired() {
            const state = governorState.get(this);
            const now = state.clock();
            for (const [id, reservation] of state.reservations) {
                if (reservation.expiresAt <= now) state.reservations.delete(id);
            }
        }

        reserveAtomically(reservationId, requested, ttlMs = 30000) {
            const state = governorState.get(this);
            if (!validId(reservationId) || !requested || typeof requested !== 'object' || Array.isArray(requested)) return false;
            if (!Number.isSafeInteger(ttlMs) || ttlMs < 1 || ttlMs > 300000) return false;
            if (state.reservations.has(reservationId)) return false;

            const normalized = Object.fromEntries(RESOURCE_KEYS.map(key => [
                key,
                requested[key] === undefined ? (key === 'concurrentObjectives' ? 1 : 0) : requested[key]
            ]));
            for (const key of RESOURCE_KEYS) {
                if (!Number.isSafeInteger(normalized[key]) || normalized[key] < 0) return false;
            }
            if (!RESOURCE_KEYS.some(key => normalized[key] > 0)) return false;

            this._releaseExpired();
            const active = Array.from(state.reservations.values());
            const usage = Object.fromEntries(RESOURCE_KEYS.map(key => [key, active.reduce((total, reservation) => total + reservation.resources[key], 0)]));
            for (const key of RESOURCE_KEYS) {
                if (usage[key] + normalized[key] > state.limits[key]) return false;
            }

            const now = state.clock();
            if (!Number.isFinite(now)) return false;
            state.reservations.set(reservationId, { resources: normalized, expiresAt: now + ttlMs });
            return true;
        }

        release(reservationId) {
            return governorState.get(this).reservations.delete(reservationId);
        }

        releaseExpired() {
            const state = governorState.get(this);
            const before = state.reservations.size;
            this._releaseExpired();
            return before - state.reservations.size;
        }

        snapshot() {
            const state = governorState.get(this);
            this._releaseExpired();
            const reservations = Array.from(state.reservations, ([id, reservation]) => ({
                id,
                resources: Object.assign({}, reservation.resources),
                expiresAt: reservation.expiresAt
            }));
            const usage = Object.fromEntries(RESOURCE_KEYS.map(key => [key,
                reservations.reduce((total, reservation) => total + reservation.resources[key], 0)
            ]));
            return freezeCopy({ limits: state.limits, usage, reservations });
        }
    }

    class ProgressOracle {
        constructor(options = {}) {
            this.verifier = typeof options.verifier === 'function' ? options.verifier : null;
        }

        async verify(progressClaim, evidence) {
            if (!progressClaim || typeof progressClaim !== 'object' || !evidence || typeof evidence !== 'object') {
                return Object.freeze({ status: 'INCONCLUSIVE', reason: 'MISSING_STRUCTURED_EVIDENCE' });
            }
            // Confidence/source counts supplied by the claimant are not independent verification.
            if (!this.verifier) return Object.freeze({ status: 'INCONCLUSIVE', reason: 'NO_INDEPENDENT_VERIFIER' });
            try {
                const result = await this.verifier(freezeCopy(progressClaim), freezeCopy(evidence));
                if (result === true) return Object.freeze({ status: 'VERIFIED', reason: 'INDEPENDENT_VERIFIER_ACCEPTED' });
                if (result === false) return Object.freeze({ status: 'NOT_VERIFIED', reason: 'INDEPENDENT_VERIFIER_REJECTED' });
                return Object.freeze({ status: 'INCONCLUSIVE', reason: 'VERIFIER_RETURNED_NO_DECISION' });
            } catch (_error) {
                return Object.freeze({ status: 'INCONCLUSIVE', reason: 'VERIFIER_FAILED' });
            }
        }
    }

    class EvolutionStateMachine {
        constructor(options = {}) {
            const governor = options.governor || new GlobalResourceGovernor(options.governorOptions);
            const oracle = options.oracle || new ProgressOracle({ verifier: options.verifier });
            const maxAuditEvents = Number.isSafeInteger(options.maxAuditEvents) ? Math.max(10, Math.min(1000, options.maxAuditEvents)) : 200;
            const maxProposals = Number.isSafeInteger(options.maxProposals) ? Math.max(5, Math.min(100, options.maxProposals)) : 30;
            machineState.set(this, {
                governor,
                oracle,
                objectives: new Map(),
                proposals: new Map(),
                proposalVersions: new Map(),
                audit: [],
                auditCapacity: maxAuditEvents,
                maxProposals,
                sequence: 0,
                stopped: false
            });
        }

        get governor() { return machineState.get(this).governor; }
        get oracle() { return machineState.get(this).oracle; }
        get auditLog() { return this.getAuditLog(); }
        get stopped() { return machineState.get(this).stopped; }

        _audit(event) {
            const state = machineState.get(this);
            if (state.audit.length >= state.auditCapacity) {
                state.stopped = true;
                return false;
            }
            state.audit.push(freezeCopy(Object.assign({ sequence: ++state.sequence }, event)));
            return true;
        }

        getAuditLog() {
            const audit = machineState.get(this).audit;
            return Object.freeze(audit.map(event => freezeCopy(event)));
        }

        getProposals() {
            const proposals = machineState.get(this).proposals;
            return Object.freeze(Array.from(proposals.values(), proposal => freezeCopy(proposal)));
        }

        proposeObjective(globalOperationId, objectiveId, requiredResources = {}) {
            const state = machineState.get(this);
            if (state.stopped) return Object.freeze({ status: 'EVOLUTION_STOPPED', reason: 'AUDIT_CAPACITY_EXHAUSTED' });
            if (!validId(globalOperationId) || !validId(objectiveId)) return Object.freeze({ status: 'REJECTED_INVALID_ID' });
            if (state.objectives.has(objectiveId)) return Object.freeze({ status: 'REJECTED_DUPLICATE_OBJECTIVE' });
            if (!this._audit({ globalOperationId, objectiveId, actionId: 'PROPOSE_ATTEMPT' })) {
                return Object.freeze({ status: 'EVOLUTION_STOPPED', reason: 'AUDIT_CAPACITY_EXHAUSTED' });
            }

            const reservationId = `evo-res-${++state.sequence}`;
            const reserved = this.governor.reserveAtomically(reservationId, requiredResources);
            if (!reserved) {
                this._audit({ globalOperationId, objectiveId, actionId: 'PROPOSE_REJECTED', reason: 'RESOURCE_LIMIT_OR_INVALID_RESERVATION' });
                return Object.freeze({ status: 'FAILED_RESOURCES', globalOperationId, objectiveId });
            }
            if (!this._audit({ globalOperationId, objectiveId, actionId: 'PROPOSE', decision: 'PROPOSED' })) {
                this.governor.release(reservationId);
                return Object.freeze({ status: 'EVOLUTION_STOPPED', reason: 'AUDIT_CAPACITY_EXHAUSTED' });
            }
            state.objectives.set(objectiveId, { globalOperationId, reservationId, status: 'PROPOSED' });
            return Object.freeze({ status: 'PROPOSED', globalOperationId, objectiveId, reservationId });
        }

        async claimProgress(globalOperationId, objectiveId, evidence) {
            const state = machineState.get(this);
            const objective = state.objectives.get(objectiveId);
            if (!objective || objective.globalOperationId !== globalOperationId) {
                return Object.freeze({ status: 'NOT_VERIFIED', reason: 'OBJECTIVE_NOT_FOUND' });
            }
            const result = await this.oracle.verify({ globalOperationId, objectiveId }, evidence);
            if (!this._audit({ globalOperationId, objectiveId, actionId: 'PROGRESS_CHECK', verification: result.status })) {
                return Object.freeze({ status: 'INCONCLUSIVE', reason: 'AUDIT_CAPACITY_EXHAUSTED' });
            }
            return result;
        }

        closeObjective(objectiveId, outcome = 'REVIEW_REQUIRED') {
            const state = machineState.get(this);
            const objective = state.objectives.get(objectiveId);
            if (!objective) return false;
            const allowed = new Set(['REVIEW_REQUIRED', 'VERIFIED', 'NOT_VERIFIED', 'CANCELLED']);
            if (!allowed.has(outcome)) return false;
            if (!this._audit({ globalOperationId: objective.globalOperationId, objectiveId, actionId: 'OBJECTIVE_CLOSED', outcome })) return false;
            this.governor.release(objective.reservationId);
            objective.status = outcome;
            return true;
        }

        createImprovementProposal(input = {}) {
            const state = machineState.get(this);
            const allowedCategories = new Set(['SAFE_BLOCK', 'RESEARCH_INSUFFICIENT', 'MISSING_INFORMATION', 'CONFLICTING_EVIDENCE']);
            if (state.stopped) return Object.freeze({ status: 'EVOLUTION_STOPPED', reason: 'AUDIT_CAPACITY_EXHAUSTED' });
            if (!allowedCategories.has(input.category) || !Number.isSafeInteger(input.evidenceCount) || input.evidenceCount < 1 || typeof input.recommendation !== 'string' || input.recommendation.length > 400) {
                return Object.freeze({ status: 'REJECTED_INVALID_PROPOSAL' });
            }
            const reservationId = `evo-proposal-${++state.sequence}`;
            if (!this.governor.reserveAtomically(reservationId, { cpuTime: 1, memoryMb: 1 })) {
                return Object.freeze({ status: 'FAILED_RESOURCES' });
            }
            try {
                const version = (state.proposalVersions.get(input.category) || 0) + 1;
                const proposal = freezeCopy({
                    id: `evo-${input.category.toLowerCase()}`,
                    category: input.category,
                    revision: version,
                    status: 'PROPOSED',
                    evidenceCount: input.evidenceCount,
                    recommendation: input.recommendation,
                    verification: 'INCONCLUSIVE',
                    authority: 'NONE',
                    requiresHumanReview: true
                });
                if (!this._audit({ actionId: 'IMPROVEMENT_PROPOSED', category: input.category, revision: version, evidenceCount: input.evidenceCount })) {
                    return Object.freeze({ status: 'EVOLUTION_STOPPED', reason: 'AUDIT_CAPACITY_EXHAUSTED' });
                }
                state.proposalVersions.set(input.category, version);
                state.proposals.set(input.category, proposal);
                while (state.proposals.size > state.maxProposals) state.proposals.delete(state.proposals.keys().next().value);
                return proposal;
            } finally {
                this.governor.release(reservationId);
            }
        }

        stop(reason = 'MANUAL_STOP') {
            const state = machineState.get(this);
            if (!this._audit({ actionId: 'STOP', reason: String(reason).slice(0, 80) })) return false;
            state.stopped = true;
            return true;
        }
    }

    const api = { GlobalResourceGovernor, ProgressOracle, EvolutionStateMachine };
    if (root && root.AI_CORE) Object.assign(root.AI_CORE, api);
    else if (root && typeof window !== 'undefined') {
        root.AI_CORE = root.AI_CORE || {};
        Object.assign(root.AI_CORE, api);
    }
    if (typeof module !== 'undefined' && module.exports) module.exports = api;
})(typeof window !== 'undefined' ? window : globalThis);
