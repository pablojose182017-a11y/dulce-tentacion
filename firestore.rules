rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. FUNCIONES HELPER (AUTORIDAD)
    // =========================================================================

    // Creador Absoluto (pablojose182017@gmail.com)
    // Idealmente se debería usar request.auth.uid == 'UID_DEL_CREADOR' en producción
    // para inmunidad contra cambios de correo.
    function isCreator() {
      return request.auth != null && (request.auth.uid == 'JT7c41zATQNrhzvWL4CdQxCAiby1' || request.auth.token.email == 'pablojose182017@gmail.com');
    }

    // Nivel de Autoridad: 100(Creador), 80(SuperAdmin), 50(Admin), 20(Trabajador), 0(Cliente)
    function getRol() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.nivel : 0;
    }

    // El perfil describe la cuenta para la interfaz; la autoridad real vive
    // exclusivamente en roles/{uid}. Un perfil propio nunca puede elevarse.
    function ownProfileRoleMatchesAuthority() {
      return (isCreator() || getRol() >= 50)
               ? request.resource.data.get('role', 'cliente') == 'admin'
                 && request.resource.data.get('rol', 'cliente') == 'admin'
                 && request.resource.data.get('isAdmin', false) == true
             : getRol() >= 20
               ? request.resource.data.get('role', 'cliente') == 'trabajador'
                 && request.resource.data.get('rol', 'cliente') == 'trabajador'
                 && request.resource.data.get('isAdmin', false) == false
             : request.resource.data.get('role', 'cliente') == 'cliente'
               && request.resource.data.get('rol', 'cliente') == 'cliente'
               && request.resource.data.get('isAdmin', false) == false;
    }

    function canCreateOwnProfile(email) {
      return request.auth != null
             && request.auth.token.email == email
             && request.resource.data.get('email', '') == email
             && request.resource.data.keys().hasOnly([
               'nombre', 'name', 'username', 'email', 'foto', 'photo',
               'role', 'rol', 'isAdmin', 'vip', 'isVip', 'vipStatus', 'vipExpiresAt', 'points', 'puntos',
               'telefono', 'phone', 'direccion', 'address', 'estado', 'blocked',
               'ultimaSincronizacion', 'ultimoIngreso', 'birthday',
               'firstPurchaseDiscountUsed', 'firstPurchaseOrderId', 'firstPurchaseDiscountDate',
               'authVerifier', 'authUpdatedAt'
             ])
             && ownProfileRoleMatchesAuthority()
             && request.resource.data.get('vip', false) == false
             && request.resource.data.get('isVip', false) == false
             && request.resource.data.get('vipStatus', 'inactivo') == 'inactivo'
             && !('vipExpiresAt' in request.resource.data)
             && request.resource.data.get('firstPurchaseDiscountUsed', false) == false
             && request.resource.data.get('blocked', false) == false
             && request.resource.data.get('estado', 'activo') == 'activo'
             && request.resource.data.get('points', 0) is number
             && request.resource.data.get('points', 0) >= 0
             && request.resource.data.get('points', 0) <= 15
             && request.resource.data.get('puntos', 0) is number
             && request.resource.data.get('puntos', 0) >= 0
             && request.resource.data.get('puntos', 0) <= 15;
    }

    // =========================================================================
    // 2. COLECCIÓN DE ROLES (NUEVA ARQUITECTURA)
    // =========================================================================
    match /roles/{uid} {
      // Lectura: Cualquier usuario autenticado (para la UI del panel)
      allow read: if request.auth != null;
      
      // Creación/Edición: Creador tiene poder absoluto. SuperAdmin no puede 
      // darse nivel >= 80 ni modificar a alguien de nivel >= 80 (incluido el Creador).
      allow create, update: if isCreator() || 
                           (getRol() >= 80 && request.resource.data.nivel < 80 
                            && (!exists(/databases/$(database)/documents/roles/$(uid)) || get(/databases/$(database)/documents/roles/$(uid)).data.nivel < 80));
      
      // Borrado: Solo Creador.
      allow delete: if isCreator();
    }

    // =========================================================================
    // 3. CONFIGURACIONES GLOBALES (adminConfig, tienda, vip)
    // =========================================================================
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if isCreator() || getRol() >= 80;
    }
    match /config/{document=**} {
      allow read: if true;
      allow write: if isCreator() || getRol() >= 80;
    }

    // =========================================================================
    // 4. USUARIOS (PERFILES Y PUNTOS)
    // =========================================================================
    match /usuarios/{email} {
      // Lectura: El propio usuario o Admin+
      allow read: if (request.auth != null && request.auth.token.email == email) || getRol() >= 50;
      
      // Un usuario puede crear solo un perfil coherente con su rol canónico.
      // Admin+ conserva el flujo de gestión de perfiles existente.
      allow create: if isCreator() || getRol() >= 50 || canCreateOwnProfile(email);

      // Actualización: Admin+ tiene control. El propio usuario está RESTRINGIDO.
      allow update: if isCreator() || getRol() >= 50 || 
                    (request.auth != null && request.auth.token.email == email &&
                     // Regla atómica del descuento de primera compra:
                     // Solo puede alterar firstPurchaseDiscountUsed si pasa de false a true,
                     // y OBLIGATORIAMENTE debe existir en la misma transacción el pedido correspondiente.
                     (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstPurchaseDiscountUsed', 'firstPurchaseOrderId', 'firstPurchaseDiscountDate']) ||
                      (
                        resource.data.get('firstPurchaseDiscountUsed', false) == false &&
                        request.resource.data.firstPurchaseDiscountUsed == true &&
                        request.resource.data.firstPurchaseOrderId is string &&
                        existsAfter(/databases/$(database)/documents/pedidos/$(request.resource.data.firstPurchaseOrderId)) &&
                        getAfter(/databases/$(database)/documents/pedidos/$(request.resource.data.firstPurchaseOrderId)).data.ownerId == request.auth.uid
                      )
                     ) &&
                     // Bloqueo estricto de campos sensibles para el cliente:
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                       'role', 'rol', 'isAdmin', 'nivel',
                       'points', 'puntos', 'puntosActuales', 'historialPuntos', 'puntosReclamadosIDs',
                       'vip', 'isVip', 'vipStatus', 'vipExpiresAt',
                       'blocked', 'estado'
                     ])
                    );
                    
      allow delete: if isCreator();
    }

    // =========================================================================
    // 5. PEDIDOS
    // =========================================================================
    match /pedidos/{pedidoId} {
      // Lectura: El dueño del pedido o Trabajador+
      allow read: if (request.auth != null && resource.data.ownerId == request.auth.uid) || getRol() >= 20;
      
      // Creación: Solo si el pedido NO existe previamente, el ownerId coincide y el estado arranca como Pendiente.
      // Validación matemática e integridad: total == (subtotal - discount) + deliveryCost, con discount >= 0.
      allow create: if request.auth != null 
                    && !exists(/databases/$(database)/documents/pedidos/$(pedidoId))
                    && request.resource.data.ownerId == request.auth.uid 
                    && request.resource.data.estado == "Pendiente"
                    && request.resource.data.subtotal is int
                    && request.resource.data.subtotal > 0
                    && request.resource.data.discount is int
                    && request.resource.data.discount >= 0
                    && request.resource.data.discount <= request.resource.data.subtotal
                    && request.resource.data.deliveryCost in [0, 5000]
                    && request.resource.data.total == (request.resource.data.subtotal - request.resource.data.discount) + request.resource.data.deliveryCost;

      // Actualización: 
      allow update: if (isCreator() || getRol() >= 50)
                      // Los administradores pueden gestionar pedidos legítimamente (abonos, estados, notas),
                      // pero NUNCA sobreescribir la identidad/creación original de un pedido preexistente.
                      ? (!('timestamp' in resource.data) || request.resource.data.timestamp == resource.data.timestamp)
                        && (!('fechaISO' in resource.data) || request.resource.data.fechaISO == resource.data.fechaISO)
                        && (!('date' in resource.data) || request.resource.data.date == resource.data.date)
                      // El trabajador solo puede modificar el estado de preparación
                      : (getRol() >= 20 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'status', 'fechaActualizacion']));
                    
      allow delete: if isCreator() || getRol() >= 50;
    }
    
    // =========================================================================
    // 6. SOLICITUDES VIP Y OTRAS COLECCIONES
    // =========================================================================
    match /solicitudes_vip/{docId} {
      allow read: if getRol() >= 50;
      allow create: if request.auth != null;
      allow update, delete: if getRol() >= 50;
    }

    // =========================================================================
    // 7. SOLICITUDES PUNTOS VIP (CLAIMS)
    // =========================================================================
    match /solicitudes_puntos/{pedidoId} {
      allow read: if (request.auth != null && request.auth.token.email == resource.data.userEmail) || getRol() >= 50;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/solicitudes_puntos/$(pedidoId))
                    && request.resource.data.estado == "Pendiente"
                    && request.resource.data.userEmail == request.auth.token.email
                    && exists(/databases/$(database)/documents/pedidos/$(pedidoId))
                    && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.ownerId == request.auth.uid;
      allow update, delete: if getRol() >= 50;
    }
  }
}
